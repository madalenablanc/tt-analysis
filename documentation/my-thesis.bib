@article{cmsSearchHighmassExclusive2024,
  title = {Search for High-Mass Exclusive Diphoton Production with Tagged Protons in Proton-Proton Collisions at \$\textbackslash sqrt\{s\}\$ = 13 {{TeV}}},
  author = {CMS and family=Collaborations, given=TOTEM, given-i=TOTEM},
  date = {2024-07-16},
  journaltitle = {Physical Review D},
  shortjournal = {Phys. Rev. D},
  volume = {110},
  number = {1},
  eprint = {2311.02725},
  eprinttype = {arXiv},
  eprintclass = {hep-ex},
  pages = {012010},
  issn = {2470-0010, 2470-0029},
  doi = {10.1103/PhysRevD.110.012010},
  url = {http://arxiv.org/abs/2311.02725},
  urldate = {2026-05-13},
  abstract = {A search is presented for high-mass exclusive diphoton production via photon-photon fusion in proton-proton collisions at \$\textbackslash sqrt\{s\}\$ = 13 TeV in events where both protons survive the interaction. The analysis utilizes data corresponding to an integrated luminosity of 103 fb\$\textasciicircum\{-1\}\$ collected in 2016-2018 with the central CMS detector and the CMS and TOTEM precision proton spectrometer (PPS). Events that have two photons with high transverse momenta (\$p\_\textbackslash mathrm\{T\}\textasciicircum γ\$ \$\textbackslash gt\$ 100 GeV), back-to-back in azimuth, and with a large diphoton invariant mass (\$m\_\{γγ\}\$ \$\textbackslash gt\$ 350 GeV) are selected. To remove the dominant inclusive diphoton backgrounds, the kinematic properties of the protons detected in PPS are required to match those of the central diphoton system. Only events having opposite-side forward protons detected with a fractional momentum loss between 0.035 and 0.15 (0.18) for the detectors on the negative (positive) side of CMS are considered. One exclusive diphoton candidate is observed for an expected background of 1.1 events. Limits at 95\% confidence level are derived for the four-photon anomalous coupling parameters \$\textbackslash lvertζ\_1\textbackslash rvert\$ \$\textbackslash lt\$ 0.073 TeV\$\textasciicircum\{-4\}\$ and \$\textbackslash lvertζ\_2\textbackslash rvert\$ \$\textbackslash lt\$ 0.15 TeV\$\textasciicircum\{-4\}\$, using an effective field theory. Additionally, upper limits are placed on the production of axion-like particles with coupling strength to photons \$f\textasciicircum\{-1\}\$ that varies from 0.03 TeV\$\textasciicircum\{-1\}\$ to 1 TeV\$\textasciicircum\{-1\}\$ over the mass range from 500 to 2000 GeV.},
  keywords = {High Energy Physics - Experiment},
  file = {/Users/utilizador/Zotero/storage/PLFJWVY9/CMS and Collaborations - 2024 - Search for high-mass exclusive diphoton production with tagged protons in proton-proton collisions a.pdf}
}

@article{collaborationIdentificationHadronicTau2022,
  title = {Identification of Hadronic Tau Lepton Decays Using a Deep Neural Network},
  author = {Collaboration, C. M. S.},
  date = {2022-07-01},
  journaltitle = {Journal of Instrumentation},
  shortjournal = {J. Inst.},
  volume = {17},
  number = {07},
  eprint = {2201.08458},
  eprinttype = {arXiv},
  eprintclass = {hep-ex},
  pages = {P07023},
  issn = {1748-0221},
  doi = {10.1088/1748-0221/17/07/P07023},
  url = {http://arxiv.org/abs/2201.08458},
  urldate = {2026-05-13},
  abstract = {A new algorithm is presented to discriminate reconstructed hadronic decays of tau leptons (\$τ\_\textbackslash mathrm\{h\}\$) that originate from genuine tau leptons in the CMS detector against \$τ\_\textbackslash mathrm\{h\}\$ candidates that originate from quark or gluon jets, electrons, or muons. The algorithm inputs information from all reconstructed particles in the vicinity of a \$τ\_\textbackslash mathrm\{h\}\$ candidate and employs a deep neural network with convolutional layers to efficiently process the inputs. This algorithm leads to a significantly improved performance compared with the previously used one. For example, the efficiency for a genuine \$τ\_\textbackslash mathrm\{h\}\$ to pass the discriminator against jets increases by 10-30\% for a given efficiency for quark and gluon jets. Furthermore, a more efficient \$τ\_\textbackslash mathrm\{h\}\$ reconstruction is introduced that incorporates additional hadronic decay modes. The superior performance of the new algorithm to discriminate against jets, electrons, and muons and the improved \$τ\_\textbackslash mathrm\{h\}\$ reconstruction method are validated with LHC proton-proton collision data at \$\textbackslash sqrt\{s\} =\$ 13 TeV.},
  keywords = {High Energy Physics - Experiment,Physics - Instrumentation and Detectors},
  file = {/Users/utilizador/Zotero/storage/QHT755E8/Collaboration - 2022 - Identification of hadronic tau lepton decays using a deep neural network.pdf}
}

@article{collaborationObservation$ggtott$Process2023,

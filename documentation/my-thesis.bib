  url = {http://arxiv.org/abs/2204.13478},
  urldate = {2026-05-13},
  abstract = {This Letter reports the observation of \$τ\$-lepton pair production in ultraperipheral lead-lead collisions, \$\textbackslash text\{Pb+Pb\} \textbackslash to \textbackslash text\{Pb\}(γγ\textbackslash to ττ)\textbackslash text\{Pb\}\$, and constraints on the \$τ\$-lepton anomalous magnetic moment, \$a\_τ\$. The dataset corresponds to an integrated luminosity of 1.44 nb\$\textasciicircum\{-1\}\$ of LHC Pb+Pb collisions at \$\textbackslash sqrt\{s\_\{\_\textbackslash text\{NN\}\}\} = 5.02\$ TeV recorded by the ATLAS experiment in 2018. Selected events contain one muon from a \$τ\$-lepton decay, an electron or charged-particle track(s) from the other \$τ\$-lepton decay, little additional central-detector activity, and no forward neutrons. The \$γγ\textbackslash to ττ\$ process is observed in Pb+Pb collisions with a significance exceeding 5 standard deviations, and a signal strength of \$μ\_\{ττ\} = 1.03\textasciicircum\{+0.06\}\_\{-0.05\}\$ assuming the Standard Model value for \$a\_τ\$. To measure \$a\_τ\$, a template fit to the muon transverse-momentum distribution from \$τ\$-lepton candidates is performed, using a dimuon (\$γγ\textbackslash to μμ\$) control sample to constrain systematic uncertainties. The observed 95\% confidence-level interval for \$a\_τ\$ is \$-0.057 {$<$} a\_τ{$<$} 0.024\$.},
  keywords = {High Energy Physics - Experiment,Nuclear Experiment},
  file = {/Users/utilizador/Zotero/storage/63G6YQCH/Collaboration - 2023 - Observation of the $γγtoττ$ process in Pb+Pb collisions and constraints on the $τ$-lepton anomalous.pdf;/Users/utilizador/Zotero/storage/NDZX6GXC/2204.html}
}

